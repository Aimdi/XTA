<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of XTA's leaves the device. android:allowBackup="false" stops
     cloud backup, but from Android 12 it no longer stops a device-to-device
     transfer, which would copy the database holding X session tokens and the
     plugin credentials onto another phone. XTA's own export is the way to move
     a setup, and it carries accounts only when the reader asks it to. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
