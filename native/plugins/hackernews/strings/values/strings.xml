<?xml version="1.0" encoding="utf-8"?>
<!-- Hacker News's text, English (the default), from XTA's wording. Written as Android writes strings;
     the plugins build turns them into the Kotlin object Strings, so they load from any class loader.
     plugin_name and plugin_description also name the plugin in the store's catalogue. -->
<resources>
    <string name="plugin_name">Hacker News</string>
    <string name="plugin_description">Read Hacker News without an account. Hearts and bookmarks stay on this device.</string>

    <string name="tab_top">Top</string>
    <string name="tab_new">New</string>
    <string name="tab_best">Best</string>
    <string name="tab_ask">Ask</string>
    <string name="tab_show">Show</string>
    <string name="tab_jobs">Jobs</string>
    <string name="tab_saved">Saved</string>
    <string name="tab_following">Following</string>
    <string name="search">Search Hacker News</string>
    <string name="settings">Settings</string>

    <string name="feed_empty">Nothing here right now</string>
    <string name="saved_empty">No saved stories yet — bookmarks stay on this device</string>
    <string name="following_empty">Follow someone to see their stories here</string>

    <plurals name="points">
        <item quantity="one">%1$d point</item>
        <item quantity="other">%1$d points</item>
