<?xml version="1.0" encoding="utf-8"?>
<!-- Immich's text, English (the default), from XTA's wording. Written as Android writes strings;
     the plugins build turns them into the Kotlin object Strings, so they load from any class loader.
     plugin_name and plugin_description also name the plugin in the store's catalogue. -->
<resources>
    <string name="plugin_name">Immich</string>
    <string name="plugin_description">Send the media of chosen bookmark folders to your own Immich server</string>
    <string name="settings_intro">Enter your Immich address and an API key from Account Settings → API Keys. Bookmark folders you switch this on for will send their photos and videos here.</string>
    <string name="server_url">Server URL</string>
    <string name="server_url_hint">For example 192.168.1.10:2283 or https://photos.example.org</string>
    <string name="api_key">API key</string>
    <string name="api_key_hint">Immich → Account Settings → API Keys</string>
    <string name="test">Test connection</string>
    <string name="test_ok">Connected to your Immich server</string>
    <string name="not_configured">Add your Immich address and API key first</string>
    <string name="error_unauthorized">Immich rejected the API key</string>
    <string name="error_server_url">No Immich server answered at that address</string>
    <string name="error_network">Could not reach your Immich server</string>
    <string name="error_generic">Your Immich server returned an error</string>
    <string name="options">Upload options</string>
    <string name="album_per_folder">An album per folder</string>
    <string name="album_per_folder_description">Uploads go into an Immich album named after the bookmark folder, created if it does not exist yet</string>
    <string name="include_videos">Upload videos too</string>
    <string name="include_videos_description">Videos and GIFs are much larger than photos. With this off, only photos are sent.</string>
    <string name="folder_hint">Switch uploading on for a folder when you create or edit it, under Bookmarks.</string>
    <string name="learn_more">About Immich</string>
    <string name="auto_upload">Upload media to Immich</string>
    <string name="auto_upload_description">Send the photos and videos of posts filed here to your Immich server</string>
    <string name="uploading">Uploading to Immich…</string>
    <string name="upload_done">Sent to Immich</string>
    <string name="upload_failed">Could not upload to Immich</string>
    <string name="show">Show</string>
    <string name="hide">Hide</string>
    <string name="save">Save</string>
    <string name="connection">Connection</string>
