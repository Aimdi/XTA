<resources>
    <string name="plugin_name">Immich</string>
    <string name="plugin_description">把所選書籤資料夾裡的媒體傳送到你自己的 Immich 伺服器</string>
    <string name="settings_intro">填寫 Immich 伺服器位址，以及在「帳戶設定 → API 金鑰」中建立的 API 金鑰。為哪些書籤資料夾開啟此項，它們的照片和影片就會傳送到這裡。</string>
    <string name="server_url">伺服器位址</string>
    <string name="server_url_hint">例如 192.168.1.10:2283 或 https://photos.example.org</string>
    <string name="api_key">API 金鑰</string>
    <string name="api_key_hint">Immich → 帳戶設定 → API 金鑰</string>
    <string name="test">測試連線</string>
    <string name="test_ok">已連線到你的 Immich 伺服器</string>
    <string name="not_configured">請先填寫位址和 API 金鑰</string>
    <string name="error_unauthorized">Immich 拒絕了這個 API 金鑰</string>
    <string name="error_server_url">這個位址上沒有 Immich 伺服器回應</string>
    <string name="error_network">無法連線到你的 Immich 伺服器</string>
    <string name="error_generic">你的 Immich 伺服器回傳了錯誤</string>
