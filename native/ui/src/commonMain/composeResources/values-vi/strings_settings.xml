    <string name="intro_welcome_title">Chào mừng bạn đến với XTA</string>
    <string name="intro_welcome_body">Trình đọc cho X và các nguồn khác. XTA chỉ đọc — không đăng, thích hay chia sẻ bất cứ gì dưới tên bạn.</string>
    <string name="intro_device_title">Ở lại trên thiết bị này</string>
    <string name="intro_device_body">Đăng ký, nhóm, lượt thích và bài đã lưu chỉ nằm trong cơ sở dữ liệu trên điện thoại này. Không có trình theo dõi.</string>
    <string name="intro_appearance_title">Chọn giao diện</string>
    <string name="intro_appearance_body">Sáng, mờ hoặc tắt đèn, cùng một màu nhấn. «Theo hệ thống» đi theo điện thoại của bạn. Có thể đổi bất cứ lúc nào trong Cài đặt.</string>
    <string name="intro_account_title">Thêm tài khoản X</string>
    <string name="intro_account_caption">Không có tài khoản, X từ chối hầu hết yêu cầu, nên lỗi sẽ xuất hiện nhiều hơn bài viết.</string>
    <string name="intro_not_now">Để sau</string>
    <string name="intro_sources_title">Chọn nguồn của bạn</string>
    <string name="intro_sources_body">Trang chủ bắt đầu với Đang theo dõi và X. Thêm nguồn ngay bây giờ, hoặc sau này bằng nút + trên Trang chủ.</string>
