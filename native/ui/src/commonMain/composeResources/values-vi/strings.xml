    <string name="import_choose_another">Chọn tệp khác</string>
    <string name="import_no_accounts">Bản sao lưu này không có tài khoản X: hãy xuất lại với “Xuất thông tin tài khoản” được bật.</string>
    <string name="import_use">Dùng bản sao lưu này</string>
    <string name="import_privacy">Bản sao lưu chứa các phiên X của bạn. XTA Native giữ chúng trên điện thoại này, chỉ gửi chúng tới X và không bao giờ đăng, thích hay theo dõi gì ở đó.</string>

