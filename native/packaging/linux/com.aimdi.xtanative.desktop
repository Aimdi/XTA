# %U also brings the files a file manager opens with the app, as file: URIs: an XTA backup (its own type, see
# com.aimdi.xtanative.mime.xml) to restore and an OPML list of feeds to follow, each asked about first.
MimeType=application/x-xta-backup;text/x-opml+xml;text/x-opml;
# %U: `xta-native <url>` opens an X link (or a page a plugin reads) in the app; a link router (handlr, junction)
# can send x.com links here. XTA claims no web scheme: it is no browser, and a link it hands
# back to the browser within seconds is not taken again, so a router cannot loop.
Exec=xta-native %U
Icon=com.aimdi.xtanative
Terminal=false
Categories=Network;News;
StartupWMClass=com-aimdi-xtanative-desktop-MainKt
# One main window: a second start raises it (SingleInstance), so a menu offers no "New window".
# The posts it opens in windows of their own come from inside the app, not from a launcher.
SingleMainWindow=true
Actions=new-search;saved;deck;settings;

