#!/bin/sh
# Starts XTA Native (bin/xta-native beside this script) with a class-data
# sharing archive of this user's: the classes a start loads, read ready-made
# from one mapped file instead of each being read, checked and laid out from
# the jars again. On a desktop under load that halved the time to Home's first
# posts and the processor time a start takes, and kept about 40 MB less in
# memory (measured against tool/mock-x, Java 17).
#
# Java 17 only takes such an archive at the folder it was made for, so it
# cannot ship in the tarball (unpacked anywhere): the first start without one
# makes it in the background, at the lowest priority, from the list of classes
# the build recorded (lib/app/xta-native.classlist, tool/cds_classlist.sh),
# into $XDG_CACHE_HOME/xta-native/cds, and the starts after it use it. A
# missing list, a failed dump or an archive Java finds out of date only means
# a start as without this script. The archive is named after this folder and
# the app's jars, so another version or place makes its own.
set -u

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
app=$here/xta-native
config=$here/../lib/app/xta-native.cfg
list=$here/../lib/app/xta-native.classlist
cache=${XDG_CACHE_HOME:-${HOME:-}/.cache}
case "$cache" in /*) ;; *) cache=${HOME:-}/.cache ;; esac
folder=$cache/xta-native/cds

if [ -f "$list" ] && [ -f "$config" ]; then
  key=$( { printf '%s\n' "$here"; cat "$config"; } | cksum | cut -d' ' -f1)
  archive=$folder/$key.jsa
  if [ -s "$archive" ]; then
    JAVA_TOOL_OPTIONS="-XX:SharedArchiveFile=$archive -Xshare:auto${JAVA_TOOL_OPTIONS:+ $JAVA_TOOL_OPTIONS}"
    export JAVA_TOOL_OPTIONS
  elif mkdir -p "$folder" 2>/dev/null && mkdir "$folder/making" 2>/dev/null; then
    # One dump at a time; -Xshare:dump ends the JVM before the app's main, and
    # --version would only print the version if it ever did not.
    (
      trap 'rm -f "$archive.part"; rmdir "$folder/making"' EXIT
      find "$folder" -maxdepth 1 -name '*.jsa' ! -name "$key.jsa" -exec rm -f {} + 2>/dev/null
      JAVA_TOOL_OPTIONS="-Xshare:dump -XX:SharedClassListFile=$list -XX:SharedArchiveFile=$archive.part -Xlog:disable" \
        nice -n 19 "$app" --version >/dev/null 2>&1 \
        && [ -s "$archive.part" ] && mv -f "$archive.part" "$archive"
    ) </dev/null >/dev/null 2>&1 &
  elif [ -d "$folder/making" ] && [ -n "$(find "$folder/making" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    # A dump that was cut off (the machine went down) leaves its mark: the next start tries again.
    rmdir "$folder/making" 2>/dev/null
  fi
fi
exec "$app" "$@"
