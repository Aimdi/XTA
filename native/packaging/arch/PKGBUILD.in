# Generated by native/tool/package_desktop.sh for XTA Native @PKGVER@; attached
# to that prerelease beside the package it builds. Install with: makepkg -si
pkgname=xta-native
pkgver=@PKGVER@
pkgrel=1
pkgdesc="XTA's X reader written in Kotlin, a prototype beside XTA (desktop build)"
arch=('x86_64')
url='https://github.com/@REPO@'
license=('MIT')
# The app carries its own Java runtime, the voice engine (ONNX Runtime and
# sherpa-onnx) and the video engine's shim; it draws through the X libraries
# and fontconfig, plays videos, GIFs and podcasts through the system's libmpv
# (as XTA's package does) and downloaded voices through it or ALSA, and opens
# links with xdg-open.
depends=('libx11' 'libxext' 'libxi' 'libxrandr' 'libxrender' 'libxtst' 'fontconfig' 'freetype2' 'alsa-lib' 'mpv' 'xdg-utils')
options=('!strip' '!debug')
_bundle="xta-native-desktop-${pkgver}-linux-x64"
source=("${_bundle}.tar.gz::https://github.com/@REPO@/releases/download/native-${pkgver}/${_bundle}.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "${_bundle}"
  install -d "${pkgdir}/opt/xta-native"
  cp -a bin lib "${pkgdir}/opt/xta-native/"
  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/xta-native" <<'LAUNCHER'
#!/bin/sh
exec /opt/xta-native/bin/xta-native "$@"
LAUNCHER
  install -Dm644 share/applications/com.aimdi.xtanative.desktop "${pkgdir}/usr/share/applications/com.aimdi.xtanative.desktop"
  install -Dm644 share/icons/hicolor/scalable/apps/com.aimdi.xtanative.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/com.aimdi.xtanative.svg"
  install -Dm644 share/metainfo/com.aimdi.xtanative.metainfo.xml "${pkgdir}/usr/share/metainfo/com.aimdi.xtanative.metainfo.xml"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
