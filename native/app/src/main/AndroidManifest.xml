<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To read the feed again when the connection comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Reading aloud and a podcast go on when the app is left, with their controls on the lock screen, as in XTA. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <!-- Settings › General › Open links in: the browsers to pick from. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Settings › Read aloud: the speech engines installed. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".XtaNativeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XtaNative"
        android:usesCleartextTraffic="${cleartext}">
        <!-- A video full screen turns the screen to its shape and may shrink into picture-in-picture, as in XTA:
             the activity takes those changes itself, so what plays goes on through them. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Text shared from another app: an X link opens its post, another link its page, anything else is searched. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- X links can open here once the phone is told to (app settings → Open by default), as XTA's
                 manifest claims them: X's hosts over http too, its t.co short links, and the mirrors chats
                 embed posts through (fxtwitter, vxtwitter, fixupx). The app's link opener routes each. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="x.com" />
                <data android:host="www.x.com" />
                <data android:host="mobile.x.com" />
                <data android:host="twitter.com" />
                <data android:host="www.twitter.com" />
                <data android:host="mobile.twitter.com" />
                <data android:host="t.co" />
                <data android:host="fxtwitter.com" />
                <data android:host="vxtwitter.com" />
                <data android:host="*.vxtwitter.com" />
                <data android:host="fixupx.com" />
                <data android:host="*.fixupx.com" />
            </intent-filter>
            <!-- Pixiv pages, which the Pixiv plugin reads, as XTA's manifest claims them. From Android 12 they
                 only come here once the reader adds them under "Open by default" (Pixiv's settings send them
                 there); a page no plugin reads goes to a browser by name, never back here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="pixiv.net" />
                <data android:host="www.pixiv.net" />
                <data android:host="pixiv.me" />
            </intent-filter>
        </activity>
        <!-- Keeps reading aloud and a podcast playing when the app is left, with the media notification
             (XTA's audio_service AudioService); its buttons come back through the receiver. -->
        <service
            android:name="com.aimdi.xtanative.ui.media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name="com.aimdi.xtanative.ui.media.PlaybackButtons"
            android:exported="false" />
        <!-- A note's attachment or the photo the media viewer shares, handed to another app one file at a time. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

    <queries>
        <!-- The browsers links can be handed to, and the one the system opens pages with. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Android 11 hides text-to-speech engines other than the default unless they are asked for. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
