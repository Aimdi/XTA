# Generated by scripts/package_linux.sh for release @TAG@; attached to that
# GitHub release beside the package it builds. Install with: makepkg -si
pkgname=xta-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='A private, read-oriented way to browse X (desktop build)'
arch=('x86_64')
url='https://github.com/Aimdi/XTA'
license=('MIT')
# The bundle carries its own Flutter engine, SQLite, ONNX Runtime and
# sherpa-onnx; video plays through the system libmpv, and file dialogs go
# through the desktop portal.
depends=('gtk3' 'mpv' 'xdg-utils' 'xdg-desktop-portal')
optdepends=(
  'xdg-desktop-portal-gtk: save and open dialogs on GTK desktops'
  'xdg-desktop-portal-kde: save and open dialogs on KDE Plasma'
  'xdg-user-dirs: save downloads into localized Pictures/Videos folders'
)
provides=('xta')
conflicts=('xta')
options=('!strip' '!debug')
_tag='@TAG@'
_bundle="xta-${_tag}-linux-x86_64"
source=("${_bundle}.tar.gz::https://github.com/Aimdi/XTA/releases/download/${_tag}/${_bundle}.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "${_bundle}"
  install -d "${pkgdir}/opt/xta" "${pkgdir}/usr/bin"
  cp -a xta lib data "${pkgdir}/opt/xta/"
  ln -s /opt/xta/xta "${pkgdir}/usr/bin/xta"
  install -Dm644 share/applications/com.aimdi.xta.desktop "${pkgdir}/usr/share/applications/com.aimdi.xta.desktop"
  install -Dm644 share/metainfo/com.aimdi.xta.metainfo.xml "${pkgdir}/usr/share/metainfo/com.aimdi.xta.metainfo.xml"
  for icon in share/icons/hicolor/*/apps/com.aimdi.xta.png; do
    install -Dm644 "${icon}" "${pkgdir}/usr/${icon}"
  done
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
